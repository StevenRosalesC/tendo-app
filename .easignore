# EAS Build Ignore Rules
# When .easignore exists, EAS uses it instead of .gitignore.
# We do NOT ignore google-services.json here so EAS can package it into the build.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/ios
/android
.agents
dev_docs/
docs/
